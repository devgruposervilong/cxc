// Modelos para CXC G&M - Cuentas por Cobrar
// La interface canónica es DataRow (salida de processFile). Estos modelos
// alinean las columnas a esa interface y solo agregan metadatos de la BD
// (id, uploadId).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  FACT
  NCR
}

// Una carga = la subida de un archivo Excel del ERP
model Upload {
  id        String     @id @default(cuid())
  fileName  String
  loadedAt  DateTime   @default(now())
  documents Document[]

  @@map("upload")
}

model Document {
  id          String       @id @default(cuid())
  uploadId    String
  rank        Int
  client      String
  rif         String?
  type        DocumentType
  number      String
  emission    String?
  expiration  String?
  overdueDays Int
  total       Decimal?
  seller      String?

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@map("document")
}
