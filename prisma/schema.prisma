// Modelos para CXC G&M - Cuentas por Cobrar
// La interface canónica es DataRow (salida de processFile). Estos modelos
// alinean las columnas a esa interface y solo agregan metadatos de la BD
// (id, uploadId).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  FACT
  NCR
}

enum SellerStatus {
  ACTIVO
  INACTIVO
}

// Una carga = la subida de un archivo Excel del ERP
model Upload {
  id        String     @id @default(cuid())
  fileName  String
  loadedAt  DateTime   @default(now())
  documents Document[]

  @@map("upload")
}

model Document {
  id          String       @id @default(cuid())
  uploadId    String
  rank        Int
  client      String
  rif         String?
  type        DocumentType
  number      String
  emission    String?
  expiration  String?
  total       Decimal?
  seller      String?

  upload Upload @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@map("document")
}

// Tabla CLIENTES del ERP (CODIGO, CLIENTE, RIF, VENDEDOR, UNIDAD_NEGOCIO).
// name es único: es la clave de unión con Document.client.
model Client {
  id           String @id @default(cuid())
  code         String @unique
  name         String @unique
  rif          String
  seller       String
  businessUnit String

  @@map("client")
}

// Tabla VENDEDORES (CODIGO, NOMBRE, APELLIDO, ZONA, KEY_URL).
// keyUrl es único: es la clave de la URL pública por vendedor.
model Seller {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  surname   String?
  zone      String?
  keyUrl    String       @unique
  status    SellerStatus @default(ACTIVO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("seller")
}
